      "reproduction_python": "import hashlib, json\nfrom kavi.composable_configurations import Configuration, Registry, Work, encoded\nfrom kavi.phase.model import PhaseConfiguration\nfrom kavi.phase.layers import CircuitTemplate, CircuitGeneration\nfrom kavi.phase.habitat import Habitat, WorldGeneration, teach_world\ndef sha(value): return hashlib.sha256(encoded(value)).hexdigest()\ncircuit = PhaseConfiguration((2,), (('x',0,1),), outputs=(((1,),1),))\nold = WorldGeneration(Habitat(), CircuitGeneration(CircuitTemplate((2,), max_couplings=0), circuit))\nnew, report = teach_world(old, [(('x',),1)], Work(limit=10000), candidates=1)\nassert report['accepted'] and new.inner is old.inner and new.inner.generation == 0\nassert sha(old.record()) != sha(new.record())\ntry:\n    PhaseConfiguration((2,), [('x',0,1)])\nexcept ValueError:\n    pass\nelse:\n    raise AssertionError('Mutable phase collection accepted')\ncalls = [('add', (0,1))]\nregistry = Registry({'plus':lambda a,w:a[0]+a[1], 'times':lambda a,w:a[0]*a[1]}, 'audit-substrate-v1')\nregistry.install('add', Configuration(2, kernel='plus'))\nregistry.install('multiply', Configuration(2, kernel='times'))\nregistry.install('combined', Configuration(2, calls, 2))\ncopied = registry.copy()\nbefore_digest = sha(registry.record())\nassert registry.execute('combined', (2,3), Work(limit=1000)) == 5\ncalls[0] = ('multiply',(0,1))\nassert copied.execute('combined', (2,3), Work(limit=1000)) == 6\nassert sha(registry.record()) != before_digest\nplan = registry.expand('add', Work(limit=1000))\nassert plan.execute((2,3), registry, Work(limit=1000)) == 5\ncopied.kernels['plus'] = lambda a,w:a[0]*a[1]\nassert plan.execute((2,3), registry, Work(limit=1000)) == 6\nwork = Work(limit=1)\nwork.add('negative_fixture', -100)\nwork.add('test_operations', 50)\nassert sum(work.counts.values()) == -50\nprint('Five bounded contract probes reproduced')\n",
